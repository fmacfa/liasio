# Prefer: python3 scripts/configure.py --domain files.example.com
DEBUG=false
DOMAIN=files.example.com
APP_URL=https://files.example.com
SECRET_KEY=replace-with-at-least-50-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
TRUST_PROXY=true
ANTIVIRUS_REQUIRED=true
CLAMAV_HOST=clamav
TIME_ZONE=Europe/Berlin
MAX_FILE_BYTES=1073741824
MAX_UPLOAD_BYTES=5368709120
DEFAULT_QUOTA_BYTES=5368709120
EVENT_RETENTION_DAYS=90
# Optional SMTP for password recovery, approved sharing/invitation emails and recipient codes.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Liasio <noreply@example.com>

# Optional on upgrades: if empty, a key is derived from SECRET_KEY. Never change it after enabling MFA.
MFA_ENCRYPTION_KEY=
TRASH_RETENTION_DAYS=30
MIN_FREE_DISK_BYTES=1073741824
# Generate a random token of at least 32 characters to enable /ready/ (Bearer auth).
MONITORING_TOKEN=
# Set an address and SMTP to opt into operational e-mail alerts.
MONITOR_EMAIL=
BACKUP_MAX_AGE_HOURS=48
# Optional prebuilt image after release:
# LINKVAULT_IMAGE=ghcr.io/fmacfa/liasio:0.5.0
# Set false to disable all file previews. Compose supplies the private socket.
PREVIEWS_ENABLED=true
# PREVIEW_SOCKET=/run/linkvault-preview/render.sock

# Optional private S3-compatible originals. Staging, previews and ZIPs still need local disk.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=auto
S3_ENCRYPTION=AES256
S3_KMS_KEY_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional OIDC; all three settings are required together. Keep the original issuer spelling.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
