# Prefer: python3 scripts/configure.py --domain files.example.com
DEBUG=false
DOMAIN=files.example.com
APP_URL=https://files.example.com
SECRET_KEY=replace-with-at-least-50-random-characters
SETUP_TOKEN=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
TRUST_PROXY=true
ANTIVIRUS_REQUIRED=true
CLAMAV_HOST=clamav
TIME_ZONE=Europe/Berlin
MAX_FILE_BYTES=104857600
MAX_UPLOAD_BYTES=524288000
DEFAULT_QUOTA_BYTES=5368709120
EVENT_RETENTION_DAYS=90
# Optional SMTP for password recovery. Invitations are copied, not emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=LinkVault <noreply@example.com>
