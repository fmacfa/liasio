{
    # Keep capability tokens out of request logs. Do not enable access logging.
    servers {
        timeouts {
            read_body 300s
            read_header 15s
            idle 120s
        }
    }
}
{$DOMAIN} {
    request_body {
        max_size 501MiB
    }
    header -Server
    reverse_proxy app:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}
