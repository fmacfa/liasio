#: static/app.js:15
msgid "Lien copié. Prêt à être partagé."
msgstr "Link copied. Ready to share."

#: static/app.js:24
msgid "Lien à copier"
msgstr "Link to copy"

#: static/app.js:27
msgid "Copiez le lien sélectionné avec votre clavier."
msgstr "Copy the selected link with your keyboard."

#: static/app.js:60
msgid ""
"%(value1)s fichier(s) sélectionné(s) · %(value2)s octets vers la corbeille"
msgstr "%(value1)s file(s) selected · %(value2)s bytes to move to the trash"

#: static/app.js:60
msgid "Sélectionnez les fichiers à supprimer."
msgstr "Select files to delete."

#: static/branding.js:14
msgid "Mon espace"
msgstr "My workspace"

#: static/branding.js:39
msgid "Optimisation de l’image…"
msgstr "Optimizing image…"

#: static/branding.js:60
msgid "Image prête. Enregistrez pour appliquer les changements."
msgstr "Image ready. Save to apply your changes."

#: static/branding.js:64
msgid ""
"Image non prise en charge. Choisissez un PNG, JPEG ou WebP de moins de 10 "
"Mio."
msgstr "Unsupported image. Choose a PNG, JPEG or WebP smaller than 10 MiB."

#: static/previews.js:47
msgid "Préparation de l’aperçu…"
msgstr "Preparing preview…"

#: static/previews.js:51
msgid "Aperçu indisponible"
msgstr "Preview unavailable"

#: static/previews.js:78
msgid "Chargement de l’aperçu…"
msgstr "Loading preview…"

#: static/previews.js:87
msgid "Aperçu de %(value1)s"
msgstr "Preview of %(value1)s"

#: static/previews.js:90
msgid ""
"Cet aperçu n’est pas disponible. Fermez cette fenêtre pour retrouver le "
"téléchargement du dossier."
msgstr ""
"This preview is unavailable. Close this window to find the collection "
"download."

#: static/upload.js:19
msgid "octets"
msgstr "bytes"

#: static/upload.js:20
#| msgid "Mio"
msgid "Kio"
msgstr "KiB"

#: static/upload.js:20
msgid "Mio"
msgstr "MiB"

#: static/upload.js:20
#| msgid "Mio"
msgid "Gio"
msgstr "GiB"

#: static/upload.js:28 static/upload.js:43
msgid "Envoi refusé. Reconnectez-vous si votre session a expiré."
msgstr "Upload refused. Sign in again if your session has expired."

#: static/upload.js:29
msgid "Envoi refusé."
msgstr "Upload rejected."

#: static/upload.js:46 static/upload.js:148 static/upload.js:167
msgid ""
"Envoi en pause. Cliquez sur Importer pour reprendre pendant les prochaines "
"24 h."
msgstr "Upload paused. Click Upload to resume within the next 24 hours."

#: static/upload.js:51
msgid "Impossible de retrouver les envois. Reconnectez-vous."
msgstr "Could not retrieve uploads. Sign in again."

#: static/upload.js:57
msgid ""
"%(value1)s fichier(s) en attente · %(value2)s % reçus. Resélectionnez les "
"mêmes fichiers puis cliquez sur Importer pour reprendre."
msgstr ""
"%(value1)s pending file(s) · %(value2)s % received. Select the same files "
"and click Upload to resume."

#: static/upload.js:58
msgid "Annuler cet envoi"
msgstr "Cancel this upload"

#: static/upload.js:70
#| msgid "%(count)s fichier(s) · %(size)s Mio"
msgid "%(count)s fichier(s) · %(size)s"
msgstr "%(count)s file(s) · %(size)s"

#: static/upload.js:94
msgid "Retirer %(name)s"
msgstr "Remove %(name)s"

#: static/upload.js:105
msgid "Chemins déjà sélectionnés conservés, sans remplacement."
msgstr "Already selected paths were kept without replacement."

#: static/upload.js:107
msgid "Maximum : 100 fichiers et 20 niveaux de dossiers par sélection."
msgstr "Maximum: 100 files and 20 folder levels per selection."

#: static/upload.js:107
msgid "Impossible de lire cette sélection. Utilisez les boutons d’ajout."
msgstr "Cannot read this selection. Use the add buttons."

#: static/upload.js:127
msgid "Lecture des dossiers…"
msgstr "Reading folders…"

#: static/upload.js:131
msgid "Les dossiers vides et les fichiers cachés ne sont pas importés."
msgstr "Empty folders and hidden files are not imported."

#: static/upload.js:139
msgid "Préparation de l’envoi…"
msgstr "Preparing upload…"

#: static/upload.js:156
msgid ""
"%(sent)s / %(total)s Mio transmis · %(confirmed)s Mio confirmés par le "
"serveur"
msgstr ""
"%(sent)s / %(total)s MiB sent · %(confirmed)s MiB confirmed by the server"

#: static/upload.js:159
msgid "%(speed)s Mio/s · environ %(seconds)s s restantes"
msgstr "%(speed)s MiB/s · about %(seconds)s s remaining"

#: static/upload.js:168
msgid "Envoi de %(value1)s"
msgstr "Uploading %(value1)s"

#: static/upload.js:174
msgid "Position du transfert invalide. Rechargez la page pour reprendre."
msgstr "Invalid upload offset. Reload the page to resume."

#: static/upload.js:178
msgid "Envoi en pause avant vérification. Cliquez sur Importer pour terminer."
msgstr "Upload paused before verification. Click Upload to finish."

#: static/upload.js:179
msgid "Transfert terminé · analyse antivirus et enregistrement…"
msgstr "Upload complete · scanning and saving…"

#: static/upload.js:180
msgid ""
"Gardez cette page ouverte. La vérification peut prendre du temps pour un "
"dossier volumineux."
msgstr "Keep this page open. Checking a large folder may take some time."

#: static/upload.js:186
msgid ""
"Connexion interrompue. Vos blocs reçus sont conservés : cliquez sur Importer"
" pour reprendre."
msgstr ""
"Connection interrupted. Received chunks are retained: click Upload to "
"resume."

#: static/upload.js:187
msgid "En attente"
msgstr "Pending"
